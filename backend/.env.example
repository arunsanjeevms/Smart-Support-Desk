# Copy this file to `.env` (same folder) and adjust the values for your machine.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# ---- MongoDB (the same connection string you use in MongoDB Compass) ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=smart_support_desk

# ---- CORS: where the Angular app is served from ----
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---- Email ----
# By default emails are printed in the Django terminal (console backend).
# To really send mail through Gmail, create an App Password
# (Google Account > Security > App passwords) and use:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Smart Support Desk <no-reply@smartsupportdesk.local>

# ---- Application ----
# Address of the Angular app, used for links in e-mails
FRONTEND_URL=http://localhost:4200
TICKET_REFERENCE_PREFIX=SSD
EXPORT_MAX_ROWS=5000
# Master switch for notification e-mails (each event can also be switched off on the Configuration screen)
EMAIL_NOTIFICATIONS=True
# Shows one-click demo sign-in buttons on the login page
DEMO_MODE=True

# ---- Similar ticket suggestions (open-source AI, runs locally) ----
# semantic = Sentence Transformers model (downloaded once, ~90 MB); keyword = TF-IDF word overlap
SIMILARITY_ENABLED=True
SIMILARITY_ENGINE=semantic
SIMILARITY_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Up to 3 suggestions, each needing at least this similarity (0-1)
SIMILARITY_MAX_RESULTS=3
SIMILARITY_MIN_SCORE=0.35

# ---- Attachments (files on tickets and comments, stored in MongoDB GridFS) ----
ATTACHMENT_MAX_FILE_MB=10
ATTACHMENT_MAX_FILES=5
ATTACHMENT_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,txt,log,csv,json,xlsx,docx,zip
