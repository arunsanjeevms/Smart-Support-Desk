# Django API for Smart Support Desk, served by Gunicorn on 127.0.0.1:8010 (Nginx proxies /api/ and /admin/).
# Installed as /etc/systemd/system/predigle-api.service by deploy/remote-release.sh.
[Unit]
Description=Smart Support Desk API (Django + Gunicorn)
After=network.target mongod.service
Wants=mongod.service

[Service]
User=predigle
Group=predigle
WorkingDirectory=/var/www/predigle/current/backend
EnvironmentFile=/var/www/predigle/shared/.env
Environment=PYTHONUNBUFFERED=1
# The AI model is cached here (downloaded once).
Environment=HF_HOME=/var/www/predigle/shared/hf-cache
# One CPU core: keep PyTorch to one thread.
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
# One worker keeps a single copy of the AI model in memory; threads handle concurrent requests.
ExecStart=/var/www/predigle/shared/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8010 \
    --workers 1 --threads 4 --worker-class gthread \
    --timeout 120 --graceful-timeout 20 \
    --forwarded-allow-ips "127.0.0.1" \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
